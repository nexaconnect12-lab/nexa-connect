<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\NexaConnect.Infrastructure\NexaConnect.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NexaConnect.Observability\NexaConnect.Observability.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NexaConnect.Contracts\NexaConnect.Contracts.csproj" />
  </ItemGroup>
  <Target Name="BuildCustomerPortal" BeforeTargets="ComputeFilesToPublish" Condition="'$(SkipCustomerPortalBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\Frontend" Command="npm ci --ignore-scripts" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\..\Frontend" Command="npm run build --workspace @nexaconnect/customer-portal" />
    <ItemGroup>
      <CustomerPortalFiles Include="$(MSBuildProjectDirectory)\..\..\Frontend\apps\customer-portal\dist\**\*" />
      <ResolvedFileToPublish Include="@(CustomerPortalFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
