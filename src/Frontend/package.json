{
  "name": "@nexaconnect/frontend",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @nexaconnect/product-owner-portal && npm run build --workspace @nexaconnect/customer-portal",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --include=dev --audit-level=moderate",
    "test:e2e:day-close:live": "playwright test --config playwright.day-close-live.config.mjs",
    "test:day-close:guards": "node --test e2e/day-close-live/settings.test.mjs",
    "test:e2e:day-close": "playwright test --config playwright.day-close.config.mjs",
    "test:e2e:end-of-day": "playwright test --config playwright.end-of-day.config.mjs",
    "test:e2e:end-of-day:live": "playwright test --config playwright.end-of-day-live.config.mjs",
    "test:end-of-day:guards": "node --test e2e/end-of-day-live/settings.test.mjs",
    "test:e2e:financial-completeness:live": "playwright test --config playwright.financial-completeness-live.config.mjs",
    "test:financial-completeness:guards": "node --test e2e/financial-completeness-live/settings.test.mjs",
    "test:e2e:financial-completeness": "playwright test --config playwright.financial-completeness.config.mjs",
    "test:e2e:cash-close": "playwright test --config playwright.cash-close.config.mjs",
    "test:e2e:kitchen": "playwright test --config playwright.kitchen.config.mjs",
    "test:e2e:phase8": "playwright test --config playwright.phase8.config.mjs",
    "test:e2e:payment-review": "playwright test --config playwright.payment-review.config.mjs",
    "test:e2e:payment-review:live": "playwright test --config playwright.payment-review-live.config.mjs",
    "test:payment-review:guards": "node --test e2e/payment-review-live/settings.test.mjs",
    "test:e2e:phase8:install": "playwright install chromium",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "24.0.0",
    "typescript": "5.4.5",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "antd": "5.16.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zod": "3.23.8"
  }
}
