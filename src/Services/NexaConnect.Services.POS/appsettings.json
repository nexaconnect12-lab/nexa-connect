{
  "Observability": {
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://localhost:4317"
  },
  "OrderSettlementConsumer": {
    "Enabled": false,
    "Exchange": "nexaconnect.events",
    "Queue": "nexaconnect.pos.order-manual-tender.v1",
    "PrefetchCount": 10
  },
  "Authentication": {
    "Authority": "https://identity.example.invalid/realms/nexa-prod",
    "Audience": "nexaconnect-api",
    "RequireHttpsMetadata": true,
    "ClockSkewSeconds": 30
  },
  "WorkloadIdentity": {
    "Authority": "https://identity.example.invalid/realms/nexa-prod",
    "ClientId": "nexaconnect-pos-service"
  },
  "Services": {
    "Restaurant": "https://restaurant.example.invalid/",
    "Authorization": "https://authorization.example.invalid/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
