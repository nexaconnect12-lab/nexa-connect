    "PlatformDirectory": "https://platform-directory.example.invalid/",
    "Restaurant": "https://restaurant.example.invalid/",
    "Order": "https://order.example.invalid/"
  },
  "WorkloadIdentity": {
    "Authority": "https://identity.example.invalid/realms/nexa-prod",
    "ClientId": "nexaconnect-payment-service"
  },
  "PaymentProvider": {
    "BaseUrl": "https://payment-provider.invalid/",
