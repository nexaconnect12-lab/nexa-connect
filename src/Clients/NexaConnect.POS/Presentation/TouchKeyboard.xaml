<UserControl x:Class="NexaConnect.POS.TouchKeyboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="False" KeyboardNavigation.TabNavigation="None">
 <Border Background="#F4F6F3" BorderBrush="#D3DDD6" BorderThickness="0,1,0,0" Padding="12,8">
  <StackPanel>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Done · Hide keyboard" Click="Hide_Click" Focusable="False" MinHeight="48" />
    <TextBlock x:Name="FieldLabel" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </DockPanel>
   <StackPanel x:Name="KeyRows" />
  </StackPanel>
 </Border>
</UserControl>
