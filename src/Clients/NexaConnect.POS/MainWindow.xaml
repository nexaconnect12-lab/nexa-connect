<Window x:Class="NexaConnect.POS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NexaConnect · Cashier" Width="1280" Height="850" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" SizeChanged="DensityWindow_SizeChanged" Background="#F4F6F3" FontFamily="Segoe UI" FontSize="{DynamicResource PosBodyFontSize}" Foreground="#172A22">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Presentation/PosTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid xmlns:pos="clr-namespace:NexaConnect.POS">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer x:Name="InputViewport" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
  <Grid x:Name="OperationalSurface" MinHeight="480" Height="{Binding ViewportHeight, ElementName=InputViewport}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="NexaConnect / Cashier" FontSize="28" FontWeight="Bold" />
        <TextBlock x:Name="ContextText" TextWrapping="Wrap" Margin="0,6,16,0" Foreground="#52655A" />
        <TextBlock x:Name="SessionText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Windows keyboard" Click="WindowsKeyboard_Click" AutomationProperties.Name="Open Windows on-screen keyboard" />
        <Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click" Style="{StaticResource Primary}" />
        <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" ToolTipService.ShowOnDisabled="True" />
      </StackPanel>
    </Grid>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="WorkspaceTab_Changed">
      <TabItem x:Name="CheckoutTab" Header="Checkout">
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="LoadMenuButton" DockPanel.Dock="Right" Content="Refresh menu" Click="LoadMenu_Click" />
                <TextBlock Text="Build an order" Style="{StaticResource Heading}" />
              </DockPanel>
              <DockPanel Grid.Row="1">
                <Button DockPanel.Dock="Right" Content="Clear filters" Click="ClearMenuSearch_Click" Margin="8,4,0,14" />
                <TextBox x:Name="MenuSearchTextBox" AutomationProperties.Name="Search menu" ToolTip="Search menu by name" TextChanged="MenuFilter_Changed" />
              </DockPanel>
              <StackPanel Grid.Row="2">
              <DockPanel>
                <TextBlock Text="Station" Margin="0,16,12,0" />
                <ComboBox x:Name="StationComboBox" SelectionChanged="StationFilter_Changed" AutomationProperties.Name="Preparation station filter" />
              </DockPanel>
                <CheckBox x:Name="ScanModeCheckBox" Content="Enable barcode scan entry (this session)" Checked="ScanMode_Changed" Unchecked="ScanMode_Changed" AutomationProperties.Name="Enable barcode scan entry" />
                <StackPanel x:Name="BarcodeScanPanel" Visibility="Collapsed">
                  <DockPanel>
                    <Button x:Name="AddBarcodeButton" DockPanel.Dock="Right" Content="Add barcode" Click="ScanBarcode_Click" IsEnabled="False" />
                    <TextBox x:Name="BarcodeScanTextBox" MaxLength="65" IsEnabled="False" PreviewKeyDown="BarcodeScan_KeyDown" AutomationProperties.Name="Product barcode scan entry" ToolTip="Focus here; scan a supported product code ending with Enter, or type it and choose Add barcode." />
                  </DockPanel>
                  <TextBlock x:Name="BarcodeScanStatus" Text="Scanner input is optional. Focus the barcode field before scanning." TextWrapping="Wrap" Foreground="#52655A" />
                </StackPanel>
              </StackPanel>
              <Grid Grid.Row="3">
                <ListBox x:Name="MenuList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Focusable" Value="False" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Button Width="{DynamicResource PosMenuWidth}" MinHeight="{DynamicResource PosMenuHeight}" Click="AddMenuItem_Click" IsEnabled="{Binding Available}" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding PreparationStation}" Foreground="#63756A" FontSize="12" Margin="0,6" />
                          <TextBlock FontSize="18">
                            <Run Text="{Binding Currency, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat=N2}" />
                          </TextBlock>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="MenuEmptyText" Text="Open a shift, then refresh the menu to start." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#63756A" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Current order" Style="{StaticResource Heading}" />
              <ListBox Grid.Row="1" x:Name="CartList" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding LineTotal, StringFormat=N2}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <Button Content="−" Width="{DynamicResource PosControlHeight}" Padding="0" Click="DecreaseQuantity_Click" AutomationProperties.Name="Decrease quantity" />
                        <TextBlock Text="{Binding Quantity}" Width="30" VerticalAlignment="Center" TextAlignment="Center" />
                        <Button Content="+" Width="{DynamicResource PosControlHeight}" Padding="0" Click="IncreaseQuantity_Click" AutomationProperties.Name="Increase quantity" />
                      </DockPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="2">
                <TextBlock Text="Cart estimate" Foreground="#52655A" />
                <TextBlock x:Name="TotalText" Foreground="#14532D" FontSize="32" FontWeight="Bold" Margin="0,4,0,16" />
                <StackPanel x:Name="OmiseTestCardPanel" Visibility="Collapsed">
                  <TextBlock Text="Omise test checkout" FontWeight="SemiBold" />
                  <TextBlock Text="Paste a fresh token from the local HTTPS test helper. Leave blank to verify the original order. Do not enter card details or keys." TextWrapping="Wrap" Margin="0,8" />
                  <PasswordBox x:Name="CardTokenBox" MaxLength="100" PasswordChanged="CardToken_Changed" AutomationProperties.Name="Fresh Omise test token" Margin="0,0,0,12" />
                </StackPanel>
                <TextBlock x:Name="PricingBreakdownText" Text="Review server pricing before confirming the order." FontSize="12" Foreground="#63756A" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="PaymentTab" Header="Payment">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <Border Style="{StaticResource Card}" Margin="0,16,0,0" MaxWidth="700" HorizontalAlignment="Center">
            <StackPanel>
              <TextBlock Text="Complete payment" Style="{StaticResource Heading}" />
              <TextBlock x:Name="PendingOrderText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20" />
              <TextBlock Text="Payment method" />
              <ComboBox x:Name="TenderMethodComboBox" SelectedIndex="0" SelectionChanged="TenderMethod_SelectionChanged" AutomationProperties.Name="Payment method">
                <ComboBoxItem Content="Cash" Tag="cash" />
                <ComboBoxItem Content="PromptPay · manually verified" Tag="promptpay_manual" />
              </ComboBox>
              <StackPanel x:Name="PromptPayQrPanel">
                <TextBlock x:Name="PromptPayQrText" TextWrapping="Wrap" />
                <Image x:Name="PromptPayQrImage" Width="220" Height="220" Margin="0,16" HorizontalAlignment="Left" />
                <TextBlock Text="Receipt or bank reference" />
                <TextBox x:Name="BankReferenceTextBox" MaxLength="64" AutomationProperties.Name="Receipt or bank reference" />
                <CheckBox x:Name="ReceiptConfirmedCheckBox" Content="I verified the received payment and receipt" VerticalContentAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Confirm only after receiving the exact amount. If the result is uncertain, verify the existing payment; do not collect again." TextWrapping="Wrap" Margin="0,16" Foreground="#63756A" />
              <TextBlock Text="Cancellation reason" Margin="0,16,0,0" />
              <TextBox x:Name="CancellationReasonTextBox" MaxLength="200" AutomationProperties.Name="Cancellation reason" />
              <WrapPanel>
                <Button Content="Customer request" Click="CancellationPreset_Click" IsEnabled="{Binding IsEnabled, ElementName=CancellationReasonTextBox}" />
                <Button Content="Item unavailable" Click="CancellationPreset_Click" IsEnabled="{Binding IsEnabled, ElementName=CancellationReasonTextBox}" />
              </WrapPanel>
              <Button x:Name="CancelOrderButton" Content="Cancel unpaid order" Click="CancelOrder_Click" ToolTipService.ShowOnDisabled="True" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="OrdersTab" Header="Orders">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Branch orders" Style="{StaticResource Heading}"/>
          <WrapPanel Grid.Row="1" Margin="0,8,0,16">
            <ComboBox x:Name="OrdersChannelFilter" SelectedIndex="0" Width="180" SelectionChanged="OrdersFilter_Changed" AutomationProperties.Name="Order source filter">
              <ComboBoxItem Content="All sources" Tag="all"/><ComboBoxItem Content="QR orders" Tag="qr"/><ComboBoxItem Content="POS orders" Tag="pos"/>
            </ComboBox>
            <ComboBox x:Name="OrdersStateFilter" SelectedIndex="0" Width="180" SelectionChanged="OrdersFilter_Changed" AutomationProperties.Name="Order status filter">
              <ComboBoxItem Content="All statuses" Tag="all"/><ComboBoxItem Content="Open orders" Tag="open"/><ComboBoxItem Content="Paid orders" Tag="paid"/>
            </ComboBox>
            <Button x:Name="RefreshOrdersButton" Content="Refresh orders" Click="RefreshOrders_Click"/>
            <Button x:Name="MoreOrdersButton" Content="Next page" Click="MoreOrders_Click"/>
          </WrapPanel>
          <DataGrid Grid.Row="2" x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" SelectionChanged="OrdersSelection_Changed" AutomationProperties.Name="Branch orders">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" Width="*" MinWidth="150"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Channel}" Width="65"/>
              <DataGridTextColumn Header="Table" Binding="{Binding TableCode}" Width="65"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="130"/>
              <DataGridTextColumn Header="Collection" Binding="{Binding CollectionLabel}" Width="135"/>
              <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N2}" Width="85"/>
              <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="70"/>
              <DataGridTextColumn Header="Created (local)" Binding="{Binding CreatedLocal, StringFormat=g}" Width="145"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="OrdersNoticeText" Text="Sign in and refresh orders. Guest requests appear after staff accepts them." TextWrapping="Wrap"/>
            <Button x:Name="CollectSelectedQrButton" Content="Load selected QR order" Click="CollectSelectedQr_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
            <TextBlock x:Name="OrdersCollectionGuidance" Text="Select an order to see collection availability." TextWrapping="Wrap" Foreground="#63756A"/>
            <TextBlock Text="Refreshes every 15 seconds while Orders is selected and this window is active. Refresh never collects or pays an order." TextWrapping="Wrap" Foreground="#63756A"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="QR collection">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <StackPanel Margin="16">
            <TextBlock Text="Collect an accepted QR order" Style="{StaticResource Heading}" />
            <TextBlock Text="Browse accepted orders to choose a QR order without typing. You can also enter the guest's collection reference. Open your shift first; continue collection with the original cashier, terminal and shift." TextWrapping="Wrap" />
            <Button Content="Browse accepted orders" Click="BrowseOrders_Click" HorizontalAlignment="Left" />
            <TextBox x:Name="QrReferenceTextBox" MaxLength="36" AutomationProperties.Name="QR collection reference or Order ID" />
            <Button x:Name="CollectQrButton" Content="Load original QR order" Click="CollectQr_Click" Style="{StaticResource Primary}" />
            <TextBlock x:Name="QrCollectionDetailsText" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ShiftCashTab" Header="Shift &amp; cash">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <Grid x:Name="ShiftCashLayout" Margin="0,16,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border x:Name="ShiftSetupCard" Style="{StaticResource Card}" Margin="0,0,16,0">
              <StackPanel>
                <TextBlock Text="Your shift" Style="{StaticResource Heading}" />
                <TextBlock x:Name="ActiveShiftText" TextWrapping="Wrap" Margin="0,0,0,16" />
                <TextBlock Text="Shift number" />
                <TextBox x:Name="ShiftNumberTextBox" AutomationProperties.Name="Shift number" />
                <WrapPanel>
                  <Button x:Name="OpenShiftButton" Content="Open shift" Click="OpenShift_Click" Style="{StaticResource Primary}" />
                  <Button x:Name="CloseShiftButton" Content="Close shift" Click="CloseShift_Click" ToolTipService.ShowOnDisabled="True" />
                </WrapPanel>
                <TextBlock Text="Close the cash session and resolve pending payments before closing your shift." TextWrapping="Wrap" Foreground="#63756A" Margin="0,12" />
                <TextBlock Text="Opening cash" />
                <TextBox x:Name="OpeningCashTextBox" Text="0" AutomationProperties.Name="Opening cash" />
                <Button x:Name="OpenCashButton" Content="Open cash session" Click="OpenCash_Click" />
                <TextBlock Text="Counted closing cash" />
                <TextBox x:Name="ClosingCashTextBox" Text="0" AutomationProperties.Name="Counted closing cash" TextChanged="ClosingCash_Changed" />
                <Button x:Name="CloseCashButton" Content="Close cash session" Click="CloseCash_Click" />
              </StackPanel>
            </Border>
            <Border x:Name="CashReconciliationCard" Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Cash reconciliation" Style="{StaticResource Heading}" />
                <TextBlock x:Name="ReconciliationStatusText" Text="Open a cash session to view reconciliation." TextWrapping="Wrap" Margin="0,0,0,12" />
                <UniformGrid Columns="2" Margin="0,0,0,8">
                  <TextBlock Text="Opening" Foreground="#63756A" />
                  <TextBlock x:Name="ReconciliationOpeningText" Text="—" FontWeight="SemiBold" />
                  <TextBlock Text="Net movements" Foreground="#63756A" />
                  <TextBlock x:Name="ReconciliationMovementsText" Text="—" FontWeight="SemiBold" />
                  <TextBlock Text="Expected cash" Foreground="#63756A" />
                  <TextBlock x:Name="ReconciliationExpectedText" Text="—" FontWeight="SemiBold" />
                  <TextBlock Text="Projected variance" Foreground="#63756A" />
                  <TextBlock x:Name="ReconciliationVarianceText" Text="—" FontWeight="SemiBold" />
                </UniformGrid>
                <Button x:Name="RefreshReconciliationButton" Content="Refresh reconciliation" Click="RefreshReconciliation_Click" HorizontalAlignment="Left" />
                <DataGrid x:Name="CashMovementList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="180" Margin="0,8,0,20" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                    <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="110" />
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Cash movements" Style="{StaticResource Heading}" />
                <TextBlock Text="Movement type" />
                <ComboBox x:Name="MovementTypeComboBox" SelectedIndex="0" AutomationProperties.Name="Cash movement type">
                  <ComboBoxItem Content="sale" />
                  <ComboBoxItem Content="refund" />
                  <ComboBoxItem Content="pay_in" />
                  <ComboBoxItem Content="pay_out" />
                  <ComboBoxItem Content="float_adjustment" />
                </ComboBox>
                <TextBlock Text="Amount" />
                <TextBox x:Name="MovementAmountTextBox" Text="0" AutomationProperties.Name="Cash movement amount" />
                <TextBlock Text="Reason" />
                <TextBox x:Name="MovementReasonTextBox" AutomationProperties.Name="Cash movement reason" />
                <Button x:Name="RecordMovementButton" Content="Record movement" Click="RecordMovement_Click" />
                <TextBlock Text="Manual cash movements do not refund or settle an order. Completed cash checkout is posted automatically when the settlement consumer is enabled." TextWrapping="Wrap" Foreground="#63756A" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="CashReviewTab" Header="Cash review">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Supervisor cash review" Style="{StaticResource Heading}" />
              <TextBlock x:Name="CashReviewAccessText" Text="Load review history to check your access." TextWrapping="Wrap" Foreground="#63756A" Margin="0,0,0,12" />
              <WrapPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="From date" />
                  <DatePicker x:Name="CashReviewFromDatePicker" Width="170" AutomationProperties.Name="Cash review from date" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="To date" />
                  <DatePicker x:Name="CashReviewToDatePicker" Width="170" AutomationProperties.Name="Cash review to date" />
                </StackPanel>
                <Button x:Name="LoadCashReviewsButton" Content="Load history" Click="LoadCashReviews_Click" Style="{StaticResource Primary}" VerticalAlignment="Bottom" />
                <Button x:Name="LoadMoreCashReviewsButton" Content="Load more" Click="LoadMoreCashReviews_Click" VerticalAlignment="Bottom" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
              <StackPanel>
                <TextBlock Text="Closed sessions" Style="{StaticResource Heading}" />
                <DataGrid x:Name="CashReviewList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionChanged="CashReviewList_SelectionChanged" Height="430" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Closed" Binding="{Binding ClosedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                    <DataGridTextColumn Header="Shift" Binding="{Binding ShiftNumber}" Width="120" />
                    <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedClosingAmount, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Counted" Binding="{Binding ActualClosingAmount, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Variance" Binding="{Binding VarianceAmount, StringFormat=N2}" Width="90" />
                    <DataGridTextColumn Header="Review" Binding="{Binding ReviewStatus}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <StackPanel>
                  <TextBlock Text="Review detail" Style="{StaticResource Heading}" />
                  <TextBlock x:Name="CashReviewDetailText" Text="Select a closed cash session." TextWrapping="Wrap" Margin="0,0,0,12" />
                  <TextBlock Text="Movements" FontWeight="SemiBold" />
                  <DataGrid x:Name="CashReviewMovementList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="135" HeadersVisibility="Column">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtUtc, StringFormat={}{0:MM-dd HH:mm}}" Width="100" />
                      <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="100" />
                      <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="85" />
                      <DataGridTextColumn Header="Reason" Binding="{Binding ReasonCode}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Text="Supervisor reason" Margin="0,14,0,0" />
                  <TextBox x:Name="CashReviewReasonTextBox" MaxLength="200" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" AutomationProperties.Name="Cash review reason" />
                  <WrapPanel>
                    <Button x:Name="InvestigateCashReviewButton" Content="Mark investigating" Click="InvestigateCashReview_Click" />
                    <Button x:Name="ApproveCashReviewButton" Content="Approve variance" Click="ApproveCashReview_Click" Style="{StaticResource Primary}" />
                  </WrapPanel>
                  <TextBlock Text="A decision records your authenticated identity and the reviewed financial version. Changed financial data requires a fresh decision." TextWrapping="Wrap" Foreground="#63756A" Margin="0,4,0,14" />
                  <TextBlock Text="Decision history" FontWeight="SemiBold" />
                  <DataGrid x:Name="CashReviewHistoryList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="150" HeadersVisibility="Column">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Time" Binding="{Binding OccurredAtUtc, StringFormat={}{0:MM-dd HH:mm}}" Width="100" />
                      <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="95" />
                      <DataGridTextColumn Header="Reviewer" Binding="{Binding ReviewerSubjectId}" Width="120" />
                      <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="ReceiptsTab" Header="Receipts">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <WrapPanel>
            <TextBox x:Name="ReceiptOrderIdTextBox" Width="320" AutomationProperties.Name="Receipt order ID" />
            <Button x:Name="LoadReceiptButton" Content="Load receipt" Click="LoadReceipt_Click" />
            <Button x:Name="PrintReceiptButton" Content="Print / reprint" Click="PrintReceipt_Click" IsEnabled="False" />
          </WrapPanel>
          <TextBlock Grid.Row="1" x:Name="ReceiptStatusText" Text="Enter a paid order ID. Loading or printing never collects payment." TextWrapping="Wrap" Margin="0,8" />
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8">
            <StackPanel>
              <TextBlock Text="Provider refund" Style="{StaticResource Heading}" />
              <TextBlock Text="Managers can refund a captured card payment. Keep the payment intent ID and operation identity until the result is verified." TextWrapping="Wrap" Foreground="#63756A" />
              <WrapPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Payment intent ID" /><TextBox x:Name="RefundPaymentIntentIdTextBox" Width="300" /></StackPanel>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="Amount THB" /><TextBox x:Name="RefundAmountTextBox" Width="120" /></StackPanel>
                <StackPanel><TextBlock Text="Reason" /><ComboBox x:Name="RefundReasonComboBox" Width="180" SelectedIndex="0"><ComboBoxItem Content="Customer request" Tag="customer_request" /><ComboBoxItem Content="Duplicate charge" Tag="duplicate_charge" /><ComboBoxItem Content="Item unavailable" Tag="item_unavailable" /><ComboBoxItem Content="Service issue" Tag="service_issue" /><ComboBoxItem Content="Other" Tag="other" /></ComboBox></StackPanel>
              </WrapPanel>
              <WrapPanel><Button x:Name="RefundButton" Content="Issue refund" Click="Refund_Click" Style="{StaticResource Primary}" /><Button x:Name="LoadRefundButton" Content="Verify pending refund" Click="LoadRefund_Click" /><Button x:Name="PrintRefundButton" Content="Print refund receipt" Click="PrintRefund_Click" IsEnabled="False" /></WrapPanel>
              <TextBlock x:Name="RefundStatusText" Text="No refund pending." TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="3" Margin="0,8">
            <TextBlock Text="Receipt preview" FontWeight="SemiBold" />
            <TextBlock x:Name="ReceiptLayoutText" TextWrapping="Wrap" Foreground="#52655A" />
          </StackPanel>
          <FlowDocumentScrollViewer Grid.Row="4" x:Name="ReceiptPreview" IsToolBarVisible="False" />
        </Grid>
      </TabItem>
      <TabItem x:Name="TerminalTab" Header="Terminal &amp; sync">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel x:Name="TerminalSetupControls" Margin="0,0,0,24">
                <TextBlock Text="Terminal setup overview" Style="{StaticResource Heading}" />
                <TextBlock Text="Configured is a setting; Detected is a last-check response. Untested and Unavailable require follow-up. Peripheral detection does not certify actual output or safe hardware use." TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button Content="Refresh setup &amp; services" Click="RefreshTerminalSetup_Click" />
                  <Button Content="Input settings" Click="OpenInputSetup_Click" />
                  <Button Content="Display setup" Click="OpenDisplaySetup_Click" />
                  <Button Content="Printer setup / test receipt" Click="OpenPrinterSetup_Click" />
                  <Button Content="Barcode setup / test" Click="OpenScannerSetup_Click" />
                  <Button Content="Export support report" Click="ExportTerminalSupport_Click" />
                </WrapPanel>
                <TextBlock x:Name="TerminalSetupStatus" Text="Run explicit checks to refresh detection. Hardware acceptance remains untested." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,8" />
                <ItemsControl x:Name="TerminalSetupList">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#D3DDD6" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel><WrapPanel><TextBlock Text="{Binding Area}" FontWeight="SemiBold" Margin="0,0,12,0" /><TextBlock Text="{Binding Status}" FontWeight="SemiBold" /></WrapPanel>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <TextBlock Text="Input settings" Style="{StaticResource Heading}" />
              <CheckBox x:Name="TouchFirstCheckBox" Content="Enable touch-first POS" Checked="TouchFirst_Changed" Unchecked="TouchFirst_Changed" AutomationProperties.Name="Enable touch-first POS" />
              <TextBlock Text="Optional. Default is keyboard and mouse operation. Changes apply immediately and are saved for this terminal and Windows user." TextWrapping="Wrap" Foreground="#52655A" Margin="0,4,0,8" />
              <TextBlock x:Name="InputModeStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,24" />
              <TextBlock Text="Display density" />
              <ComboBox x:Name="DensityPicker" SelectionChanged="Density_Changed" AutomationProperties.Name="Display density" MaxWidth="400" HorizontalAlignment="Left" MinWidth="220">
                <ComboBoxItem Content="Standard (default)"/><ComboBoxItem Content="Touch · larger controls"/>
              </ComboBox>
              <TextBlock x:Name="DensityStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,24" />
              <StackPanel x:Name="PrinterSetupControls" Margin="0,0,0,24">
                <TextBlock Text="Receipt printer" Style="{StaticResource Heading}" />
                <TextBlock Text="Printer" />
                <ComboBox x:Name="ReceiptPrinterPicker" DisplayMemberPath="Label" MaxWidth="520" HorizontalAlignment="Stretch" AutomationProperties.Name="Receipt printer" />
                <TextBlock Text="Receipt layout" />
                <ComboBox x:Name="ReceiptPaperPicker" MaxWidth="520" HorizontalAlignment="Stretch" AutomationProperties.Name="Receipt paper layout">
                  <ComboBoxItem Content="Standard page (default)" /><ComboBoxItem Content="80 mm roll" />
                </ComboBox>
                <WrapPanel>
                  <Button Content="Refresh printers" Click="RefreshPrinters_Click" />
                  <Button Content="Save printer settings" Click="SavePrinterSettings_Click" />
                  <Button Content="Preview test receipt" Click="PreviewTestReceipt_Click" />
                  <Button Content="Print test receipt" Click="PrintTestReceipt_Click" />
                </WrapPanel>
                <TextBlock x:Name="PrinterSetupStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <FlowDocumentScrollViewer x:Name="TestReceiptPreview" IsToolBarVisible="False" Height="220" Margin="0,8,0,0" AutomationProperties.Name="Test receipt preview" />
              </StackPanel>
              <TextBlock Text="Staff and customer displays" Style="{StaticResource Heading}" />
              <TextBlock Text="Use Windows extended desktop. Select roles on each startup; customer view contains no input or unlock controls." TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Staff display" />
              <ComboBox x:Name="StaffDisplayPicker" DisplayMemberPath="Label" AutomationProperties.Name="Staff display" />
              <TextBlock Text="Customer display" />
              <ComboBox x:Name="CustomerDisplayPicker" DisplayMemberPath="Label" AutomationProperties.Name="Customer display" />
              <WrapPanel>
                <Button Content="Refresh displays" Click="RefreshDisplays_Click" />
                <Button x:Name="ApplyDisplaysButton" Content="Apply display roles" Click="ApplyDisplays_Click" />
                <Button x:Name="DisableCustomerDisplayButton" Content="Use staff screen only" Click="DisableCustomerDisplay_Click" />
              </WrapPanel>
              <TextBlock x:Name="DisplayStatusText" TextWrapping="Wrap" Margin="0,0,0,24" />
              <TextBlock Text="Terminal management" Style="{StaticResource Heading}" />
              <TextBlock Text="Terminal code" />
              <TextBox x:Name="TerminalCodeTextBox" Text="POS-001" MaxWidth="400" HorizontalAlignment="Left" MinWidth="280" AutomationProperties.Name="Terminal code" />
              <Button x:Name="EnrollTerminalButton" Content="Enroll terminal" Click="EnrollTerminal_Click" HorizontalAlignment="Left" />
              <TextBlock Text="Cash movement synchronization" Style="{StaticResource Heading}" Margin="0,24,0,16" />
              <TextBlock x:Name="OutboxStatusText" Margin="0,0,0,16" />
              <DataGrid x:Name="OutboxOperationList" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220" Margin="0,0,0,12" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Operation" Binding="{Binding OperationId}" Width="230" />
                  <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" />
                  <DataGridTextColumn Header="Attempts" Binding="{Binding Attempts}" Width="75" />
                  <DataGridTextColumn Header="HTTP" Binding="{Binding TerminalFailureStatusCode}" Width="65" />
                  <DataGridTextColumn Header="Last attempt" Binding="{Binding LastAttemptAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
              <WrapPanel>
                <Button x:Name="ReplayOutboxButton" Content="Sync pending movements" Click="ReplayOutbox_Click" />
                <Button x:Name="RetryRejectedOutboxButton" Content="Retry rejected movements" Click="RetryRejectedOutbox_Click" />
              </WrapPanel>
              <TextBlock Text="Resolve the authorization or configuration issue before retrying rejected movements. Pending movements must sync before their cash session can close." TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
  </ScrollViewer>
    <Border x:Name="WorkflowDock" Grid.Row="1" Background="White" BorderBrush="#D3DDD6" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="24,0,24,8">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="WorkflowAmountColumn" Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="WorkflowTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="WorkflowDescription" Foreground="#52655A" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="WorkflowAmountLabel" FontSize="11" Foreground="#52655A" TextWrapping="Wrap"/>
            <TextBlock x:Name="WorkflowAmount" FontSize="22" FontWeight="SemiBold" Foreground="#14532D" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Button x:Name="WorkflowNextButton" Click="WorkflowNext_Click" Margin="0" />
            <Button x:Name="PlaceOrderButton" Content="Send order · Continue to payment" Click="PlaceOrder_Click" Style="{StaticResource Primary}" Margin="0" ToolTipService.ShowOnDisabled="True" />
            <Button x:Name="PaidButton" Content="Confirm payment received" Click="Paid_Click" Style="{StaticResource Primary}" Margin="0" />
          </StackPanel>
        </Grid>
        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="Action in progress"/>
        <ScrollViewer x:Name="WorkflowStatusScroll" MaxHeight="54" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0,6,0,0">
          <StackPanel>
            <TextBlock x:Name="SessionGuidanceText" TextWrapping="Wrap" FontSize="12" Foreground="#52655A" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <pos:TouchKeyboard x:Name="InputKeyboard" Grid.Row="2" Visibility="Collapsed" />
    <Border x:Name="SessionLockOverlay" Visibility="Collapsed" Background="#13251B"
            Grid.RowSpan="3" Panel.ZIndex="100" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="POS locked" AutomationProperties.HelpText="Tap or press a key to show authentication controls. Your workspace remains locked.">
      <Grid ClipToBounds="True">
        <Image x:Name="StaffGalleryImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <TextBlock x:Name="StaffFallbackBrand" Text="NexaConnect" FontSize="40" Foreground="White" Opacity="0.65"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        <Border x:Name="StaffLockScrim" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="LockAuthenticationPanel" Background="#ED10251A" CornerRadius="12" Padding="24" Margin="24"
                Visibility="Collapsed" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="Authenticate to resume"
                MaxWidth="480" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="NexaConnect" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="StaffGalleryTitle" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
              <TextBlock x:Name="StaffGalleryCaption" TextWrapping="Wrap" FontSize="16" Margin="0,4,0,0"/>
              <TextBlock Text="Workspace locked" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,8" />
              <TextBlock Text="Your shift and saved work are retained. Authenticate as the original cashier to resume."
                         FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock x:Name="LockStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" />
              <Button x:Name="ResumeButton" Content="Resume / Authenticate" Click="SignIn_Click" Style="{StaticResource Primary}" />
              <Button Content="Windows keyboard" Click="WindowsKeyboard_Click" />
              <Button x:Name="LockedSignOutButton" Content="Sign out" Click="SignOut_Click" />
              <Button x:Name="BackToScreensaverButton" Content="Back to screensaver" Click="BackToScreensaver_Click" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="DisplaySafetyOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#F4F6F3" Padding="40" Panel.ZIndex="200">
      <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="NexaConnect" FontSize="28" FontWeight="SemiBold" Foreground="#14532D" />
        <TextBlock Text="Display setup changed" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" Margin="0,24,0,16" />
        <TextBlock Text="Staff content is hidden and the customer window is closed. Stop customer use, reconnect the staff display, then restart POS on the private staff screen and select display roles again. Saved work is retained." FontSize="20" TextWrapping="Wrap" Margin="0,0,0,24" />
        <Button Content="Close POS safely" Click="CloseForDisplaySafety_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
