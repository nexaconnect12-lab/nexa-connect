<Window x:Class="NexaConnect.POS.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NexaConnect POS" Height="720" Width="1180" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12"><TextBlock Text="NexaConnect POS" FontSize="26" FontWeight="SemiBold" DockPanel.Dock="Left"/><TextBlock x:Name="SessionText" Text="Signed out" HorizontalAlignment="Right"/></DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="SignInButton" Width="110" Content="Sign in" Click="SignIn_Click"/>
            <Button x:Name="SignOutButton" Width="110" Margin="8,0,0,0" Content="Sign out" Click="SignOut_Click" IsEnabled="False"/>
            <Button x:Name="OpenShiftButton" Width="120" Margin="8,0,0,0" Content="Open shift" Click="OpenShift_Click" IsEnabled="False"/>
            <Button x:Name="CloseShiftButton" Width="120" Margin="8,0,0,0" Content="Close shift" Click="CloseShift_Click" IsEnabled="False"/>
            <Button x:Name="LoadMenuButton" Width="120" Margin="8,0,0,0" Content="Load menu" Click="LoadMenu_Click" IsEnabled="False"/>
        </StackPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Menu" Margin="0,0,12,0"><ListBox x:Name="MenuList" MouseDoubleClick="MenuList_DoubleClick"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C2}}" HorizontalAlignment="Right"/><TextBlock Text="{Binding PreparationStation}" Margin="12,0,0,0" Foreground="Gray"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox>
            <GroupBox Grid.Column="1" Header="Current order"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="CartList" Grid.Row="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Quantity, StringFormat= x{0}}" Margin="12,0,0,0"/><TextBlock Text="{Binding LineTotal, StringFormat={}{0:C2}}" HorizontalAlignment="Right"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" x:Name="TotalText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,12"/><Button Grid.Row="2" Content="Remove selected" Click="RemoveCart_Click"/><Button Grid.Row="3" x:Name="PlaceOrderButton" Content="Place order" Margin="0,8,0,0" Click="PlaceOrder_Click" IsEnabled="False"/></Grid></GroupBox>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBox x:Name="ShiftNumberTextBox" Width="240" HorizontalAlignment="Left" Text="SHIFT-001"/><TextBlock x:Name="ActiveShiftText" Margin="0,6,0,0"/><TextBlock x:Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
    </Grid>
</Window>
