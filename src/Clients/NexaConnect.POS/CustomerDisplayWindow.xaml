<Window x:Class="NexaConnect.POS.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexaConnect · Customer" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Background="#F4F6F3" Foreground="#172A22" FontFamily="Segoe UI" FontSize="20">
  <Grid IsHitTestVisible="False" Focusable="False">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="1" Background="#A5B8AB"/>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <Grid x:Name="TransactionView" Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="CustomerShopName" Text="{Binding ShopName}" Foreground="#14532D" FontSize="26" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DisplayHeading}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap" Margin="0,24,0,12" />
      <TextBlock x:Name="CustomerMessage" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,24" />
    </StackPanel>
      <ItemsControl ItemsSource="{Binding Lines}">
        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Grid.Row" Value="1"/></Style></ItemsControl.Style>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Padding="16" Margin="0,0,0,12" Background="White" CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0">
                  <Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " />
                  <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat=N2}" />
                  <Run Text="  =  " /><Run Text="{Binding LineTotal, Mode=OneWay, StringFormat=N2}" />
                </TextBlock>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    <StackPanel Grid.Row="2">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
        <DataTrigger Binding="{Binding Total}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      </Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding Currency}" FontWeight="SemiBold" Margin="0,16,0,8" />
      <TextBlock Text="{Binding Subtotal, StringFormat=Subtotal: {0:N2}}" />
      <TextBlock Text="{Binding ServiceCharge, StringFormat=Service charge: {0:N2}}" />
      <TextBlock Text="{Binding Tax, StringFormat=Tax: {0:N2}}" />
      <TextBlock Text="{Binding TotalLabel}" FontSize="24" Margin="0,16,0,0" />
      <TextBlock x:Name="CustomerTotalText" Text="{Binding Total, StringFormat=N2}" FontSize="48" FontWeight="Bold" Foreground="#14532D" />
      <TextBlock x:Name="CustomerTenderText" Text="{Binding Tender}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
  </ScrollViewer>
  <Border x:Name="TableQrPanel" Grid.Column="2" Background="#F4F6F3" Padding="24" Visibility="Collapsed">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Order from your phone" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
      <Image x:Name="TableQrImage" Grid.Row="1" Margin="0,12" MaxWidth="360" MaxHeight="360" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Table ordering QR code"/>
      <TextBlock x:Name="TableQrCaption" Grid.Row="2" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
  </Border>
  <Border x:Name="SaverView" Grid.Column="0" Background="#13251B">
    <Grid ClipToBounds="True">
      <TextBlock Text="{Binding ShopName}" Foreground="White" FontSize="30" TextWrapping="Wrap" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      <Image x:Name="SaverImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Border x:Name="SaverTextPanel" Background="#D910251A" Padding="24" Margin="24" VerticalAlignment="Bottom">
        <StackPanel TextElement.Foreground="White">
          <TextBlock x:Name="SaverTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SaverCaption" FontSize="20" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
  </Grid>
</Window>
