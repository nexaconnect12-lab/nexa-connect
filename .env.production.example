KEYCLOAK_VERSION=26.7.0
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0@sha256:0f198be292568439d700cdbfb893e69a6009bb43a94a06a945b1d3d506c76b13
KEYCLOAK_DB_URL=jdbc:postgresql://postgres.internal:5432/keycloak?sslmode=verify-full
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=InjectFromSecretManager
KEYCLOAK_DB_POOL_SIZE=20
KEYCLOAK_NETWORK=nexa-identity

KEYCLOAK_PUBLIC_URL=https://identity.example.com
KEYCLOAK_ADMIN_URL=https://identity-admin.example.com
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=10.0.0.0/24
KEYCLOAK_LOG_LEVEL=info
KEYCLOAK_TEMP_ADMIN_USERNAME=temporary-bootstrap-admin
KEYCLOAK_TEMP_ADMIN_PASSWORD=InjectFromSecretManager

KEYCLOAK_REALM=nexa-prod
KEYCLOAK_REALM_DISPLAY_NAME=Nexa
KEYCLOAK_SMTP_HOST=smtp.example.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=noreply@example.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Nexa
KEYCLOAK_SMTP_USER=InjectFromSecretManager
KEYCLOAK_SMTP_PASSWORD=InjectFromSecretManager
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
NEXACONNECT_WEB_BFF_CLIENT_SECRET=InjectFromSecretManager
NEXACONNECT_ADMIN_BFF_CLIENT_SECRET=InjectFromSecretManager
NEXACONNECT_WEB_BFF_REDIRECT_URI=https://app.example.com/signin-oidc
NEXACONNECT_WEB_BFF_POST_LOGOUT_REDIRECT_URI=https://app.example.com/signout-callback-oidc
NEXACONNECT_WEB_ORIGIN=https://app.example.com
NEXACONNECT_ADMIN_BFF_REDIRECT_URI=https://admin.example.com/signin-oidc
NEXACONNECT_ADMIN_BFF_POST_LOGOUT_REDIRECT_URI=https://admin.example.com/signout-callback-oidc
NEXACONNECT_ADMIN_ORIGIN=https://admin.example.com
NEXACONNECT_MOBILE_REDIRECT_URI=nexaconnect://oauth/callback
NEXACONNECT_POS_REDIRECT_URI=nexaconnect-pos://oauth/callback

# Configure every API deployment with:
# Authentication__Authority=https://identity.example.com/realms/nexa-prod
# Authentication__Audience=nexaconnect-api
# Authentication__RequireHttpsMetadata=true
