# Production-only template. Inject certificate passwords through a secret manager.
# Do not copy this file into the development .env or commit populated values.
ASPNETCORE_URLS=https://+:8443
Tls__CertificatePath=/run/secrets/nexaconnect-tls.pfx
Tls__CertificatePassword=ReplaceWithTlsCertificatePassword
DataProtection__KeyDirectory=/var/lib/nexaconnect/data-protection
DataProtection__CertificatePath=/run/secrets/nexaconnect-data-protection.pfx
DataProtection__CertificatePassword=ReplaceWithDataProtectionCertificatePassword
DataProtection__ApplicationName=nexaconnect-service
