# Production-only template. Inject certificate passwords through a secret manager.
# Do not copy this file into the development .env or commit populated values.
ASPNETCORE_URLS=https://+:8443
Tls__CertificatePath=/run/secrets/nexaconnect-tls.pfx
Tls__CertificatePassword=ReplaceWithTlsCertificatePassword
DataProtection__KeyDirectory=/var/lib/nexaconnect/data-protection
DataProtection__CertificatePath=/run/secrets/nexaconnect-data-protection.pfx
DataProtection__CertificatePassword=ReplaceWithDataProtectionCertificatePassword
DataProtection__ApplicationName=nexaconnect-service
KeycloakAdmin__BaseUrl=https://identity.example.com/
KeycloakAdmin__Realm=nexa-production
KeycloakAdmin__ClientId=platform-directory-admin
KeycloakAdmin__ClientSecret=ReplaceFromSecretManager
MediaStorage__ServiceUrl=https://object-storage.example.invalid
MediaStorage__Bucket=nexaconnect-media
MediaStorage__AccessKey=ReplaceFromSecretManager
MediaStorage__SecretKey=ReplaceFromSecretManager
MediaSafety__MalwareScanEnabled=true
MediaSafety__ClamAvHost=clamav.internal.example
MediaSafety__ClamAvPort=3310
# Pending and ready original bytes only; generated variants need separate bucket-capacity monitoring.
MediaQuota__MaximumStoredBytes=1073741824
MediaQuota__MaximumPendingUploads=20
Services__Catalog=https://catalog.example.com/
WorkloadIdentity__ClientId=nexaconnect-media-service
WorkloadIdentity__ClientSecret=ReplaceFromSecretManager
WorkloadIdentity__Authority=https://identity.example.com/realms/nexa-production
ConnectionStrings__Media=Host=media-db;Database=NexaConnect_Media;Username=nexaconnect_media_app;Password=ReplaceFromSecretManager;SSL Mode=Require
Services__PlatformDirectory=https://platform-directory.example.com/
Services__Authorization=https://authorization.example.com/
Authentication__Authority=https://identity.example.com/realms/nexa-production
Authentication__Audience=nexaconnect-api
Outbox__Exchange=nexaconnect.events
# This shared example enables dispatch for existing producers. POS cash-close deployments
# must initially override Outbox__Enabled=false until the Reporting binding is ready.
Outbox__Enabled=true
Outbox__ConnectionString=amqps://ReplaceFromSecretManager

# Payment authorization provider. Do not place PAN, CVV, provider tokens, or response payloads in configuration or logs.
# Keep Disabled until provider onboarding, secret injection, and live-sandbox acceptance are complete; then set GenericHttp.
PaymentProvider__Adapter=Disabled
PaymentProvider__BaseUrl=https://payment-provider.example.com/
PaymentProvider__AuthorizationPath=v1/authorizations
PaymentProvider__AuthorizationStatusPath=v1/authorizations
PaymentProvider__CapturePath=v1/captures
PaymentProvider__CaptureStatusPath=v1/captures
PaymentProvider__VoidPath=v1/voids
PaymentProvider__VoidStatusPath=v1/voids
PaymentProvider__RefundPath=v1/refunds
PaymentProvider__RefundStatusPath=v1/refunds
# Inject through the deployment secret manager; omit only when the selected provider contract does not use bearer authentication.
PaymentProvider__ApiKey=ReplaceFromSecretManager
PaymentProvider__RequestTimeout=00:00:15
PaymentProvider__LeaseDuration=00:02:00
PaymentProvider__MaximumCaptureRecoveryAttempts=3
PaymentProvider__RecoveryInterval=00:00:30
PaymentProvider__CaptureRecoveryEnabled=true
PaymentProvider__MaximumVoidRecoveryAttempts=3
PaymentProvider__VoidRecoveryEnabled=true
PaymentProvider__MaximumRefundRecoveryAttempts=3
PaymentProvider__RefundRecoveryEnabled=true
# Set independently per Payment and Order deployment; do not combine service metrics in one process.
OperationalMetrics__PollInterval=00:00:30

# Notification service and Customer BFF notification-read integration.
ConnectionStrings__Notification=Host=notification-db;Database=NexaConnect_Notification;Username=nexaconnect_notification_app;Password=ReplaceFromSecretManager;SSL Mode=Require
Persistence__Provider=PostgreSQL
NotificationConsumer__Enabled=false
NotificationConsumer__Exchange=nexaconnect.events
NotificationConsumer__Queue=nexaconnect.notification.requested.v1
NotificationConsumer__Prefetch=16
NotificationDelivery__Enabled=false
NotificationDelivery__PollInterval=00:00:02
NotificationDelivery__Lease=00:02:00
NotificationDelivery__MaximumAttempts=8
NotificationProvider__BaseUrl=https://provider.example.com/
NotificationProvider__Path=notifications
NotificationProvider__ReceiptPath=notifications/{id}
NotificationProvider__ProviderCode=replace-with-provider-code
NotificationProvider__ApiToken=ReplaceFromSecretManager
Services__Notification=https://notification.example.com/
# POS Order manual-tender consumer. Inject the RabbitMQ URI through the deployment secret store.
OrderSettlementConsumer__Enabled=false
OrderSettlementConsumer__ConnectionString=
OrderSettlementConsumer__Exchange=nexaconnect.events
OrderSettlementConsumer__Queue=nexaconnect.pos.order-manual-tender.v1
OrderSettlementConsumer__PrefetchCount=10

# Customer BFF online Kitchen queue dependency; use the actual trusted service address.
Services__Kitchen=https://kitchen.example.invalid/

# POS cash-close scanner (POS deployment only; requires POS migration 6).
CashClosePublication__Enabled=false
# Reporting cash-close consumer (Reporting deployment only; requires Reporting migration 15).
# Verify the consumer-ready log and broker binding before enabling POS outbox dispatch.
CashCloseConsumer__Enabled=false
CashCloseConsumer__ConnectionString=amqps://ReplaceFromSecretManager
CashCloseConsumer__Exchange=nexaconnect.events
CashCloseConsumer__Queue=nexaconnect.reporting.cash-close.v1
PaymentRefundConsumer__Enabled=false
PaymentRefundConsumer__ConnectionString=amqps://ReplaceFromSecretManager
PaymentRefundConsumer__Exchange=nexaconnect.events
PaymentRefundConsumer__Queue=nexaconnect.reporting.payment-refunds.v1
PaymentRefundConsumer__PrefetchCount=16
# Reporting end-of-day draft owning-service reads; customer tokens authorize each source.
Services__Order=https://order.example.invalid/
Services__Payment=https://payment.example.invalid/
Services__POS=https://pos.example.invalid/
# Customer BFF report adapter; use the actual trusted Reporting host.
Services__Reporting=https://reporting.example.invalid/

# Apply Order 11 / Reporting 19 (application 0.22.0); establish queue before Order publication.
OrderSaleConsumer__Enabled=false
OrderSaleConsumer__ConnectionString=amqps://ReplaceFromSecretManager
OrderSaleConsumer__Exchange=nexaconnect.events
OrderSaleConsumer__Queue=nexaconnect.reporting.order-sales.v1
OrderSaleConsumer__PrefetchCount=16

# Reporting deployment only: authoritative branch hierarchy and dedicated metadata reader.
Services__Restaurant=https://restaurant.example.invalid/
WorkloadIdentity__Authority=https://identity.example.invalid/realms/nexa-prod
WorkloadIdentity__ClientId=nexaconnect-reporting-service
WorkloadIdentity__ClientSecret=ReplaceWithDistinctReportingSecretFromSecretManager
# Keycloak deployment mapping for the same dedicated workload client:
NEXACONNECT_REPORTING_SERVICE_CLIENT_SECRET=ReplaceWithDistinctReportingSecretFromSecretManager
