# Production-only template. Inject certificate passwords through a secret manager.
# Do not copy this file into the development .env or commit populated values.
ASPNETCORE_URLS=https://+:8443
Tls__CertificatePath=/run/secrets/nexaconnect-tls.pfx
Tls__CertificatePassword=ReplaceWithTlsCertificatePassword
DataProtection__KeyDirectory=/var/lib/nexaconnect/data-protection
DataProtection__CertificatePath=/run/secrets/nexaconnect-data-protection.pfx
DataProtection__CertificatePassword=ReplaceWithDataProtectionCertificatePassword
DataProtection__ApplicationName=nexaconnect-service
KeycloakAdmin__BaseUrl=https://identity.example.com/
KeycloakAdmin__Realm=nexa-production
KeycloakAdmin__ClientId=platform-directory-admin
KeycloakAdmin__ClientSecret=ReplaceFromSecretManager
MediaStorage__ServiceUrl=https://object-storage.example.invalid
MediaStorage__Bucket=nexaconnect-media
MediaStorage__AccessKey=ReplaceFromSecretManager
MediaStorage__SecretKey=ReplaceFromSecretManager
MediaSafety__MalwareScanEnabled=true
MediaSafety__ClamAvHost=clamav.internal.example
MediaSafety__ClamAvPort=3310
# Pending and ready original bytes only; generated variants need separate bucket-capacity monitoring.
MediaQuota__MaximumStoredBytes=1073741824
MediaQuota__MaximumPendingUploads=20
Services__Catalog=https://catalog.example.com/
WorkloadIdentity__ClientId=nexaconnect-media-service
WorkloadIdentity__ClientSecret=ReplaceFromSecretManager
WorkloadIdentity__Authority=https://identity.example.com/realms/nexa-production
ConnectionStrings__Media=Host=media-db;Database=NexaConnect_Media;Username=nexaconnect_media_app;Password=ReplaceFromSecretManager;SSL Mode=Require
Services__PlatformDirectory=https://platform-directory.example.com/
Services__Authorization=https://authorization.example.com/
Authentication__Authority=https://identity.example.com/realms/nexa-production
Authentication__Audience=nexaconnect-api
Outbox__Exchange=nexaconnect.events
Outbox__Enabled=true
Outbox__ConnectionString=amqps://ReplaceFromSecretManager

# Notification service and Customer BFF notification-read integration.
ConnectionStrings__Notification=Host=notification-db;Database=NexaConnect_Notification;Username=nexaconnect_notification_app;Password=ReplaceFromSecretManager;SSL Mode=Require
Persistence__Provider=PostgreSQL
NotificationConsumer__Enabled=false
NotificationConsumer__Exchange=nexaconnect.events
NotificationConsumer__Queue=nexaconnect.notification.requested.v1
NotificationConsumer__Prefetch=16
Services__Notification=https://notification.example.com/
