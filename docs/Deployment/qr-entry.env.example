# Apply to Restaurant only, after Restaurant migration 4 and scoped staff verification.
QrEntry__Enabled=false
# Apply to Customer BFF only. Enable both deliberately for an isolated QR1 test.
QrGuest__Enabled=false
QrGuest__PublicOrigin=https://customer.example.com
# QR2: Customer BFF only, separately opt-in after Order/Catalog deployment.
QrGuest__MenuEnabled=false
# QR2: Order only; uses existing Order workload credentials for Catalog/pricing.
QrMenu__Enabled=false
# QR3: Order only, after migrations20–22 and PostgreSQL grants. Requires QrMenu enabled.
QrRequests__Enabled=false
# QR3: Customer BFF only, additionally requires QrGuest/ MenuEnabled.
QrGuest__RequestsEnabled=false
# QR4: Order, after migrations21–22; requires requests, HTTP adapters and recovery enabled.
QrAcceptance__Enabled=false
# QR5: Order only, after migration22 and matching exact-shift/store POS admission binaries.
QrCollection__Enabled=false
# QR4: Customer BFF, additional to all prior QR flags.
QrGuest__AcceptanceEnabled=false
# Existing Services__Restaurant must be direct HTTPS and private to trusted infrastructure.
# No guest client secret, guest Keycloak role or public Restaurant listener is required.
