# Customer service production template. Inject secrets from the environment secret manager.
ASPNETCORE_URLS=https://+:8443
Tls__CertificatePath=/run/secrets/nexaconnect-tls.pfx
Tls__CertificatePassword=ReplaceFromSecretManager
DataProtection__KeyDirectory=/var/lib/nexaconnect/customer-data-protection
DataProtection__CertificatePath=/run/secrets/nexaconnect-data-protection.pfx
DataProtection__CertificatePassword=ReplaceFromSecretManager
DataProtection__ApplicationName=nexaconnect-customer
Persistence__Provider=PostgreSQL
ConnectionStrings__Customer=Host=customer-db;Database=NexaConnect_Customer;Username=nexaconnect_customer_app;Password=ReplaceFromSecretManager;SSL Mode=VerifyFull;Root Certificate=/run/secrets/postgres-ca.crt
Authentication__Authority=https://identity.example.com/realms/nexa-production
Authentication__Audience=nexaconnect-api
Services__PlatformDirectory=https://platform-directory.example.com/
Services__Authorization=https://authorization.example.com/
Outbox__Enabled=true
Outbox__Exchange=nexaconnect.events
Outbox__ConnectionString=amqps://ReplaceFromSecretManager
Observability__OtlpEnabled=true
Observability__OtlpEndpoint=https://otel-collector.example.com:4317
