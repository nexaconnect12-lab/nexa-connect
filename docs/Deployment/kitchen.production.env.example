# Kitchen service production template. Inject secrets from the environment secret manager.
ASPNETCORE_URLS=https://+:8443
Persistence__Provider=PostgreSQL
ConnectionStrings__Kitchen=Host=kitchen-db;Database=NexaConnect_Kitchen;Username=nexaconnect_kitchen_app;Password=ReplaceFromSecretManager;SSL Mode=Require
Authentication__Authority=https://identity.example.com/realms/nexa-production
Authentication__Audience=nexaconnect-api
Services__PlatformDirectory=https://platform-directory.example.com/
Services__Restaurant=https://restaurant.example.com/
Services__Authorization=https://authorization.example.com/
WorkloadIdentity__Authority=https://identity.example.com/realms/nexa-production
WorkloadIdentity__ClientId=nexaconnect-kitchen-service
WorkloadIdentity__ClientSecret=ReplaceFromSecretManager
Outbox__Enabled=true
Outbox__Exchange=nexaconnect.events
Outbox__ConnectionString=amqps://ReplaceFromSecretManager
Observability__OtlpEnabled=true
Observability__OtlpEndpoint=https://otel-collector.example.com:4317
