  "roles": {
    "realm": [
      { "name": "system-admin", "description": "Legacy shared-platform administrator; migrate assignments to platform roles" },
      { "name": "platform-owner", "description": "Shared-platform owner" },
      { "name": "platform-admin", "description": "Shared-platform administrator" },
      { "name": "platform-support", "description": "Shared-platform support operator" },
      { "name": "platform-auditor", "description": "Read-only shared-platform auditor" },
      { "name": "customer-owner", "description": "Organization-scoped customer owner" },
      { "name": "customer-admin", "description": "Organization-scoped customer administrator" },
      { "name": "customer-manager", "description": "Organization-scoped customer manager" },
      { "name": "customer-user", "description": "Organization-scoped customer user" },
      { "name": "customer-viewer", "description": "Organization-scoped customer viewer" },
      { "name": "tenant-admin", "description": "Organization administrator" },
      { "name": "store-manager", "description": "Restaurant store manager" },
      { "name": "cashier", "description": "Restaurant cashier" },
      { "name": "inventory-controller", "description": "Inventory operator" },
      { "name": "accountant", "description": "Accounting operator" },
      { "name": "report-viewer", "description": "Reporting reader" },
      { "name": "support-agent", "description": "Shared-platform support agent" }
    ]
  },
  "scopeMappings": [
    {
      "clientScope": "nexaconnect-api",
      "roles": [
        "system-admin",
        "platform-owner",
        "platform-admin",
        "platform-support",
        "platform-auditor",
        "customer-owner",
        "customer-admin",
        "customer-manager",
        "customer-user",
        "customer-viewer",
        "tenant-admin",
        "store-manager",
        "cashier",
        "inventory-controller",
        "accountant",
        "report-viewer",
        "support-agent"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect profile claims",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email claims",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "nexaconnect-api",
      "description": "Audience and coarse realm-role claims for NexaConnect APIs",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "nexaconnect-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "nexaconnect-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-platform-directory-admin",
      "enabled": true,
      "serviceAccountClientId": "platform-directory-admin",
      "clientRoles": {
        "realm-management": ["view-users", "manage-users", "view-realm"]
      }
    }
  ],
