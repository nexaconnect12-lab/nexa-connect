      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${NEXACONNECT_WEB_BFF_REDIRECT_URI}"],
      "webOrigins": ["${NEXACONNECT_WEB_ORIGIN}"],
      "attributes": {
        "post.logout.redirect.uris": "${NEXACONNECT_WEB_BFF_POST_LOGOUT_REDIRECT_URI}"
      },
      "defaultClientScopes": ["basic", "profile", "email", "nexaconnect-api"],
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "nexaconnect-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexaconnect-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
