{
  "realm": "${NEXA_REALM_NAME}",
  "displayName": "${NEXA_REALM_DISPLAY_NAME}",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": ${NEXA_VERIFY_EMAIL},
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and digits(1) and lowerCase(1) and upperCase(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "${NEXA_SMTP_HOST}",
    "port": "${NEXA_SMTP_PORT}",
    "from": "${NEXA_SMTP_FROM}",
    "fromDisplayName": "${NEXA_SMTP_FROM_DISPLAY_NAME}",
    "auth": "${NEXA_SMTP_AUTH}",
    "user": "${NEXA_SMTP_USER}",
    "password": "${NEXA_SMTP_PASSWORD}",
    "starttls": "${NEXA_SMTP_STARTTLS}",
    "ssl": "${NEXA_SMTP_SSL}"
  },
